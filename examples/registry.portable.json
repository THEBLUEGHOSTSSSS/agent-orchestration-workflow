  "policy": {
    "similarity_threshold": 0.46,
    "recency_half_life_days": 90,
    "recency_window_days": 365,
    "version_discount": 0.5,
    "shrinkage_samples": 4,
    "confidence_medium_samples": 4,
    "confidence_high_samples": 12,
    "exploration_gap": 0.075,
    "exploration_max_samples": 3,
    "failure_penalty": 0.16,
    "cost_penalty": 0.04,
    "latency_penalty": 0.02,
    "repair_penalty": 0.05,
    "task_type_groups": [
      [
        "routine_coding",
        "implementation",
        "bugfix",
        "refactoring",
        "large_execution"
      ],
      [
        "algorithms",
        "numerics",
        "concurrency",
        "invariants",
        "reasoning"
      ],
      [
        "documentation",
        "writing",
        "editing"
      ]
    ],
    "failure_severity": {
      "none": 0,
      "low": 0.25,
      "medium": 0.6,
      "high": 1
    },
    "failure_type_weights": {
      "FORMATTING_ERROR": 0.25,
      "LOCAL_IMPLEMENTATION_ERROR": 0.5,
      "INCOMPLETE_EXECUTION": 0.6,
      "REASONING_FAILURE": 1,
      "ARCHITECTURE_FAILURE": 1,
      "LOOP_BEHAVIOR": 1,
      "CONTEXT_HANDLING_FAILURE": 1,
      "ALGORITHM_FAILURE": 1,
      "INVARIANT_FAILURE": 1
    },
    "default_failure_type_weight": 0.75,
    "repair_quality_penalty": 0.5,
    "exploration_enabled": true,
    "similarity_weights": {
      "domain": 0.19,
      "task_type": 0.21,
      "related_task_type": 0.12,
      "task_subtype": 0.1,
      "language": 0.07,
      "framework": 0.05,
      "scope": 0.06,
      "complexity": 0.05,
      "tool_intensity": 0.05,
      "cross_module_scope": 0.04,
      "estimated_execution_volume": 0.03,
      "reasoning_intensity": 0.04,
      "risk_level": 0.06,
      "verification_strength": 0.05
    }
  },
  "execution_timeout_seconds": 300
}
